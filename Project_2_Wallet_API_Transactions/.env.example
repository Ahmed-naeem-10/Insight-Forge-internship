# Application Settings
PROJECT_NAME="GlobalPay Wallet API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (SQLite default for zero-setup, PostgreSQL compatible)
DATABASE_URL="sqlite:///./wallet_app.db"

# JWT Security Settings
# Generate secure key in production with: openssl rand -hex 32
SECRET_KEY="replace-this-with-a-secure-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

